{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "outDir": "public/dist",
    "rootDir": "public/src",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "sourceMap": false,
    "declaration": false
  },
  "include": ["public/src/**/*"]
}
